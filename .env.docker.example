# Docker deployment configuration. Copy to .env.docker before `npm run docker -- up -d --build`.
# Use `npm run docker:stack -- up -d --build` to include the sibling erp-frontend project.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

APP_VERSION=2.0.0

# --- required ---
JWT_SECRET=replace-with-64-random-chars
JWT_REFRESH_SECRET=replace-with-a-different-64-random-chars
# Comma-separated browser origins allowed to call the API. Must be https outside localhost.
CORS_ORIGINS=https://erp.example.com
# Public origin of the web app; invoice QR codes point here.
PUBLIC_URL=https://erp.example.com

# --- networking ---
# Host port for the web container; terminate TLS in front of it.
WEB_PORT=8080
# The API is published on loopback only, so the desktop POS on this host can still reach it.
API_BIND=127.0.0.1
API_PORT=4000
# Reverse-proxy hops in front of the API (bundled nginx = 1, plus one per external proxy).
TRUST_PROXY=1

# --- optional ---
# Point at an external/managed MongoDB (with credentials) instead of the bundled container.
# MONGODB_URI=mongodb://user:pass@mongo-host:27017/moto?replicaSet=rs0&authSource=admin
LOG_LEVEL=info
RATE_LIMIT_MAX=600
BACKUP_RETENTION_DAYS=14

# Baked into the web bundle at build time. Leave /api to use the bundled nginx proxy.
VITE_API_URL=/api
VITE_SOCKET_URL=

# web = operator sends via WhatsApp; cloud = authenticated Meta Cloud API
WHATSAPP_MODE=web
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_COUNTRY_CODE=20

