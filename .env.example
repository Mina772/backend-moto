NODE_ENV=development
PORT=4000
# Replica set is required for multi-document transactions (docker-compose.yml in this folder provides rs0; use .env.docker for Docker).
MONGODB_URI=mongodb://localhost:27017/moto?replicaSet=rs0&directConnection=true
JWT_SECRET=change-me-to-a-long-random-string-32+chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PUBLIC_URL=http://localhost:5173
UPLOAD_DIR=uploads
LOG_LEVEL=info
COOKIE_SECURE=false
# `none` (implies Secure) is required when the web app is on a different origin than the API.
COOKIE_SAMESITE=lax
BCRYPT_COST=12
# web = wa.me deep link from the shop's own account | cloud = authenticated Meta Cloud API
WHATSAPP_MODE=web
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- operations ---
# Shown by /api/health; the Docker image sets it from the build argument.
APP_VERSION=
MONGO_POOL_SIZE=20
# Override the system resolvers, e.g. 1.1.1.1,8.8.8.8 — needed if mongodb+srv fails with
# "Server record does not share hostname with parent URI" (router randomises SRV letter case).
DNS_SERVERS=
# Reverse-proxy hops to trust for client IP (0 when the API is exposed directly).
TRUST_PROXY=1
JSON_BODY_LIMIT=2mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
# Readiness fails for SHUTDOWN_DRAIN_MS before the listener closes (production only).
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=15000

# First installation only: init-admin requires ADMIN_PASSWORD (10+ characters),
# BRANCH_NAME_AR, BRANCH_CITY_AR and BRANCH_ADDRESS_AR with real business details.
# Supply them when running init-admin; company identity and tax details are entered in Settings.
