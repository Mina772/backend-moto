{
  "name": "moto-erp-backend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "dist/server.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "predev": "node --env-file-if-exists=.env scripts/local-mongo.mjs --detached",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run && npm run test --workspaces --if-present",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db": "node --env-file-if-exists=.env scripts/local-mongo.mjs",
    "db:start": "node --env-file-if-exists=.env scripts/local-mongo.mjs --detached",
    "db:stop": "node --env-file-if-exists=.env scripts/local-mongo.mjs --stop",
    "init-admin": "tsx --env-file-if-exists=.env src/db/init-admin.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/db/reset-data.ts",
    "migrate:prices": "tsx --env-file-if-exists=.env src/db/migrations/001-three-tier-prices.ts",
    "pack": "node scripts/pack-api.mjs",
    "docker": "docker compose --env-file .env.docker -f docker-compose.yml",
    "docker:stack": "docker compose --env-file .env.docker -f docker-compose.yml -f ../erp-frontend/docker-compose.yml"
  },
  "dependencies": {
    "@moto/shared": "*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^2.0.1",
    "node-cron": "^4.6.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "esbuild": "0.28.2",
    "eslint": "^9.12.0",
    "globals": "^15.10.0",
    "mongodb": "^6.21.0",
    "mongodb-memory-server": "^10.1.2",
    "pino-pretty": "^11.2.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.8.0",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
